# BugScope Environment Configuration
BUGSCOPE_API_KEY=
BUGSCOPE_MODEL=gemini-2.0-flash
BUGSCOPE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
BUGSCOPE_HOST=127.0.0.1
BUGSCOPE_PORT=8000
# Database Configuration
# For local development without Docker, SQLite is used automatically (bugscope.db).
BUGSCOPE_DB_PATH=bugscope.db

# If using Docker Compose with PostgreSQL:
POSTGRES_USER=bugscope
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bugscope

# Sandbox Resource Limits
BUGSCOPE_DOCKER_TIMEOUT=30
BUGSCOPE_MEMORY_LIMIT=512m
BUGSCOPE_CPU_LIMIT=1.0
BUGSCOPE_TOKEN_BUDGET=8000
